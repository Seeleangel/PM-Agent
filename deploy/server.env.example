# 示例端口和路径，按实际安装位置及未占用端口修改。
HOST=127.0.0.1
PORT=8788
BASE_PATH=/agent
DATA_DIR=/var/lib/shared-agent/data
WORKSPACE_DIR=/var/lib/shared-agent/workspace
MEMORY_DIR=/var/lib/shared-agent/memory
LARK_ROOT_DIR=/var/lib/shared-agent/lark
CLAUDE_BIN=/opt/shared-agent/runtime/claude
PATH=/opt/shared-agent/runtime:/usr/local/bin:/usr/bin:/bin
ALLOW_REGISTRATION=true
SECURE_COOKIES=true
DISABLE_EXTERNAL_INTEGRATIONS=true
REQUIRE_MODEL_CREDENTIAL=true
MAX_PRIVATE_CONCURRENCY=1
MAX_PRIVATE_PER_USER=1
MAX_CONCURRENT_RUNS=1
REQUEST_TIMEOUT_MS=1800000
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,Bash,WebSearch,WebFetch
DISABLE_UPDATES=1
DISABLE_AUTOUPDATER=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
